{
  "expo": {
    "name": "Wayfinder",
    "slug": "wayfinder",
    "scheme": "wayfinder",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.wayfinder.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.wayfinder.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
